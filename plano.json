<!DOCTYPE html>
<html lang="en">
	<meta charset="utf-8">
	<title>404 - Page Not Found</title>
	<link rel="icon" href="/images/favicon.ico" type="image/x-icon">
	<link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
	<link href='//fonts.googleapis.com/css?family=Open+Sans:400,300,600' rel='stylesheet' type='text/css'>
	
	<style>
		body > div {
			color:#696d70;
			font-family:"Open Sans", Helvetica, Arial, sans-serif;
			font-size:16px;
			font-weight:300;
			overflow:hidden;
			line-height:30px;
			text-align:center;
			position: absolute;
			height: 600px;
			width: 800px;
			left: 50%;
			top: 15%;
			margin-left: -400px;
			}
		h1 {
			color:black;
			display:block;
			font-size:176px;
			font-weight:400;
			height:200px;
			line-height:200px;
			margin:0;
			padding:0;
			margin-bottom:20px;
			text-align:center;
			}
		div > span:nth-child(2) {
			display:block;
			font-size:32px;
			height:30px;
			line-height:30px;
			margin:0;
			margin-bottom:30px;
			padding:0;
			text-align:center;
			text-transform:uppercase;
			}
		div > span:nth-child(3) {
			display:block;
			font-size:18px;
			height:30px;
			line-height:30px;
			margin:0;
			margin-bottom:30px;
			padding:0;
			padding-bottom:30px;
			text-align:center;
			}
		a {
			background-color:#696d70;
			background-image:none;
			color:white !important;
			cursor:pointer;
			display:inline-block;
			font-size:14px;
			font-weight:600;
			height:30px;
			line-height:30px;
			margin:0 5px;
			padding:6px 27px;
			text-align:center;
			text-decoration:none !important;
			transition: all 0.2s ease-in;
			border-radius:5px;
			width:130px;
			padding:6px 0;
			}
		a:hover {
			background: #494949 !important;
			}
		span:last-child {
			color:#aaa;
			display:block;
			font-size:14px;
			height:30px;
			line-height:30px;
			margin:0 auto;
			margin-top:60px;
			padding:0;
			text-align:center;
			border: 1px solid #ddd;
			width: 220px;
			border-radius: 20px;
			}
	</style>
</head>

<body>
	<div>
		<h1>404</h1>
		<span>Page Not Found</span>
		<span>The requested document was not found on this server.</span>
		<a href="https://www.simbrief.com">Home Page</a>
		<a onclick="window.history.back()">Go Back</a>
		<span>Web Server at simbrief.com</span>
	</div>
</body>
</html>